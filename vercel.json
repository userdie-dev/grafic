{
  "version": 2,
  "functions": {
    "backend/api/**/*.ts": {
      "runtime": "@vercel/node@latest"
    }
  },
  "routes": [
    {
      "src": "/health",
      "dest": "backend/api/health.ts"
    },
    {
      "src": "/health-copy",
      "dest": "backend/api/health-copy.ts"
    },
    {
      "src": "/neon",
      "dest": "backend/api/neon.ts"
    }
  ]
}
